+void XMLCALL xmlEnd(void* data, const XML_Char* name)
+{
+    auto& xml = *static_cast<XmlData*>(data);
+    try
+    {
+        require(!xml.path.empty());
+        if (xml.path.size() >= 2 && xml.path[xml.path.size() - 2] == "AuxObjectData" && std::strcmp(name, "flags") != 0)
+        {
+            const long n = number(xml.text, 0, std::strcmp(name, "usTileLocIndex") == 0 ? UINT16_MAX : UINT8_MAX);
+            auto& aux = xml.aux[xml.index];
+            if (std::strcmp(name, "usTileLocIndex") == 0) aux.usTileLocIndex = static_cast<UINT16>(n);
+            else if (std::strcmp(name, "ubCurrentFrame") == 0) aux.ubCurrentFrame = static_cast<UINT8>(n);
+            else if (std::strcmp(name, "ubNumberOfFrames") == 0) aux.ubNumberOfFrames = static_cast<UINT8>(n);
+            else if (std::strcmp(name, "ubNumberOfTiles") == 0) aux.ubNumberOfTiles = static_cast<UINT8>(n);
+            else if (std::strcmp(name, "ubWallOrientation") == 0) aux.ubWallOrientation = static_cast<UINT8>(n);
+        }
+        xml.path.pop_back(); xml.text.clear();
+    }
+    catch (...) { xml.failed = true; XML_StopParser(xml.parser, XML_FALSE); }
+}
+void XMLCALL xmlText(void* data, const XML_Char* text, int size)
+{
+    auto& xml = *static_cast<XmlData*>(data);
+    try
+    {
+        // The legacy parser records character data only for numeric properties.
+        if (xml.path.size() < 2 || xml.path[xml.path.size() - 2] != "AuxObjectData" || xml.path.back() == "flags") return;
+        require(size >= 0 && static_cast<std::size_t>(size) <= xmlLimit - xml.text.size());
+        xml.text.append(text, static_cast<std::size_t>(size));
+    }
+    catch (...) { xml.failed = true; XML_StopParser(xml.parser, XML_FALSE); }
+}
+void XMLCALL xmlDoctype(void* data, const XML_Char*, const XML_Char*, const XML_Char*, int)
+{
+    auto& xml = *static_cast<XmlData*>(data);
+    xml.failed = true; XML_StopParser(xml.parser, XML_FALSE);
+}
+void parseXml(const std::vector<UINT8>& bytes, std::size_t count, UINT16 contents, Sections& result)
+{
+    require(!bytes.empty() && bytes.size() <= xmlLimit);
+    XmlData xml;
+    xml.aux.resize(count); xml.offsets.resize(count); xml.seen.resize(count);
+    xml.parser = XML_ParserCreate(nullptr); require(xml.parser != nullptr);
+    std::unique_ptr<std::remove_pointer<XML_Parser>::type, decltype(&XML_ParserFree)> owner(xml.parser, XML_ParserFree);
+    XML_SetUserData(xml.parser, &xml);
+    XML_SetElementHandler(xml.parser, xmlStart, xmlEnd);
+    XML_SetCharacterDataHandler(xml.parser, xmlText);
+    XML_SetStartDoctypeDeclHandler(xml.parser, xmlDoctype);
+    // XML_Parse takes int lengths; feed bounded chunks without imposing an
+    // additional maximum document size beyond the container/FileMan limit.
+    for (std::size_t position = 0; position < bytes.size();)
+    {
+        const auto length = (std::min)(bytes.size() - position, std::size_t(65536));
+        const bool last = position + length == bytes.size();
+        require(XML_Parse(xml.parser, reinterpret_cast<const char*>(bytes.data() + position), static_cast<int>(length), last ? XML_TRUE : XML_FALSE) == XML_STATUS_OK && !xml.failed);
+        position += length;
+    }
+    std::size_t sum = 0; for (const auto& aux : xml.aux) sum += aux.ubNumberOfFrames;
+    require(sum <= count);
+    if (contents & IMAGE_APPDATA)
+    {
+        result.image.pAppData = reinterpret_cast<UINT8*>(copy(xml.aux.data(), xml.aux.size()));
+        result.image.uiAppDataSize = static_cast<UINT32>(count * sizeof(AuxObjectData));
+        result.image.fFlags |= IMAGE_APPDATA;
+    }
+    if (contents & IMAGE_BITMAPDATA)
+        for (std::size_t i = 0; i < count; ++i) if (xml.offsets[i].overrideValue)
+        { result.image.pETRLEObject[i].sOffsetX = xml.offsets[i].x; result.image.pETRLEObject[i].sOffsetY = xml.offsets[i].y; }
+}
+bool commit(HIMAGE target, Sections& result, UINT16 contents)
+{
+    auto& source = result.image;
+    require(!(target->fFlags & IMAGE_ALLDATA & ~contents) ||
+            (target->usWidth == source.usWidth && target->usHeight == source.usHeight && target->ubBitDepth == source.ubBitDepth));
+    ReleaseImageData(target, contents);
+    if (contents & IMAGE_PALETTE) { target->pPalette = source.pPalette; source.pPalette = nullptr; }
+    if (contents & IMAGE_APPDATA) { target->pAppData = source.pAppData; target->uiAppDataSize = source.uiAppDataSize; source.pAppData = nullptr; }
+    if (contents & IMAGE_BITMAPDATA)
+    {
+        target->pImageData = source.pImageData; source.pImageData = nullptr;
+        target->uiSizePixData = source.uiSizePixData;
+        target->pETRLEObject = source.pETRLEObject; source.pETRLEObject = nullptr;
+        target->usNumberOfObjects = source.usNumberOfObjects; source.usNumberOfObjects = 0;
