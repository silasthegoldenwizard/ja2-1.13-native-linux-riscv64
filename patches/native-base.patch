+void PollAudioGap(UINT32 sample, AudioGapList* list)
+{
+    if (!list) return;
+    list->audio_gap_active = FALSE;
+    if (!list->size || !list->pHead) return;
+    const auto time = SoundGetPosition(sample);
+    // Keep the original rescan and strict endpoints, including loop/restart
+    // handling. Progress is the existing sound manager's wall-clock contract.
+    auto* gap = list->pHead;
+    while (gap && time > gap->uiEnd) gap = gap->pNext;
+    if (gap && time > gap->uiStart && time < gap->uiEnd)
+        list->audio_gap_active = TRUE;
+}
