+static INT32 FindMapInventoryPoolObject( const OBJECTTYPE *pObject )
+{
+	if (!fShowMapInventoryPool || pObject == NULL)
+	{
+		return -1;
+	}
+
+	for (UINT32 x = 0; x < pInventoryPoolList.size(); ++x)
+	{
+		if (&pInventoryPoolList[x].object == pObject)
+		{
+			return static_cast<INT32>(x);
+		}
+	}
+
+	return -1;
+}
+
 BOOLEAN OBJECTTYPE::TransformObject( SOLDIERTYPE * pSoldier, UINT8 ubStatusIndex, TransformInfoStruct * Transform, OBJECTTYPE *pParent )
+{
+	INT32 iPoolSlot = FindMapInventoryPoolObject(this);
+	OBJECTTYPE *pPoolObject = this;
+	if (iPoolSlot < 0)
+	{
+		iPoolSlot = FindMapInventoryPoolObject(pParent);
+		pPoolObject = pParent;
+	}
+
+	if (iPoolSlot < 0)
+	{
+		return TransformObjectInternal(pSoldier, ubStatusIndex, Transform, pParent, FALSE);
+	}
+
+	if (!ReserveMapInventoryPoolSlot(iPoolSlot))
+	{
+		AssertMsg(FALSE, String("OBJECTTYPE::TransformObject could not reserve its sector inventory slot."));
+		return FALSE;
+	}
+
+	OBJECTTYPE stablePoolObject;
+	if (pPoolObject->MoveThisObjectTo(stablePoolObject) != 0)
+	{
+		ReleaseMapInventoryPoolSlot(iPoolSlot);
+		AssertMsg(FALSE, String("OBJECTTYPE::TransformObject could not move its sector inventory item to stable storage."));
+		return FALSE;
+	}
+
+	OBJECTTYPE *pStableTransformObject = (pPoolObject == this) ? &stablePoolObject : this;
+	OBJECTTYPE *pStableParent = (pPoolObject == pParent) ? &stablePoolObject : pParent;
+	if (gpItemDescObject == pPoolObject)
+	{
+		gpItemDescObject = &stablePoolObject;
+	}
+	if (gpItemDescPrevObject == pPoolObject)
+	{
+		gpItemDescPrevObject = &stablePoolObject;
+	}
+
+	BOOLEAN fResult = pStableTransformObject->TransformObjectInternal(
+		pSoldier, ubStatusIndex, Transform, pStableParent, TRUE);
+
+	if (static_cast<size_t>(iPoolSlot) >= pInventoryPoolList.size())
+	{
+		ReleaseMapInventoryPoolSlot(iPoolSlot);
+		AssertMsg(FALSE, String("OBJECTTYPE::TransformObject lost its reserved sector inventory slot."));
+		return FALSE;
+	}
+	if (pInventoryPoolList[iPoolSlot].object.exists())
+	{
+		ReleaseMapInventoryPoolSlot(iPoolSlot);
+		AssertMsg(FALSE, String("OBJECTTYPE::TransformObject reserved sector inventory slot was reused."));
+		return FALSE;
+	}
+	if (stablePoolObject.MoveThisObjectTo(pInventoryPoolList[iPoolSlot].object) != 0)
+	{
+		ReleaseMapInventoryPoolSlot(iPoolSlot);
+		AssertMsg(FALSE, String("OBJECTTYPE::TransformObject could not restore its sector inventory item."));
+		return FALSE;
+	}
+	ReleaseMapInventoryPoolSlot(iPoolSlot);
+
+	if (gpItemDescObject == &stablePoolObject)
+	{
+		gpItemDescObject = &pInventoryPoolList[iPoolSlot].object;
+	}
+	if (gpItemDescPrevObject == &stablePoolObject)
+	{
+		gpItemDescPrevObject = &pInventoryPoolList[iPoolSlot].object;
+	}
+
+	return fResult;
+}
