+	// Native Lua/UI numeric IDs may be wider than the original 32-bit input.
+	// Preserve the original constructors' UINT16 wrap-then-clamp behavior for
+	// that exact signed/unsigned domain; refuse wider values as NOBODY. This
+	// named boundary accepts integral numeric IDs, never object pointers.
+	template<typename Integer, typename std::enable_if<
+		std::is_integral<Integer>::value && (sizeof(Integer) > 1), int>::type = 0>
+	static constexpr SoldierID FromLegacyNumericID(Integer value)
+	{
+		if constexpr (std::is_signed<Integer>::value)
+		{
+			if (value < std::numeric_limits<INT32>::min() || value > std::numeric_limits<INT32>::max())
+				return SoldierID{};
+			return SoldierID(static_cast<INT32>(value));
+		}
+		else
+		{
+			if (value > std::numeric_limits<UINT32>::max()) return SoldierID{};
+			return SoldierID(static_cast<UINT32>(value));
+		}
+	}
+
