+static void FreePlayerGroupListStorage( PLAYERGROUP *&pHead )
+{
+	while ( pHead )
+	{
+		PLAYERGROUP *pNode = pHead;
+		pHead = pHead->next;
+		MemFree( pNode );
+	}
+}
+
+static void FreeWayPointListStorage( WAYPOINT *&pHead )
+{
+	while ( pHead )
+	{
+		WAYPOINT *pNode = pHead;
+		pHead = pHead->next;
+		MemFree( pNode );
+	}
+}
+
+static void FreeStrategicMovementGroupStorage( GROUP *pGroup )
+{
+	if ( !pGroup )
+		return;
+
+	FreeWayPointListStorage( pGroup->pWaypoints );
+	if ( pGroup->usGroupTeam == OUR_TEAM )
+		FreePlayerGroupListStorage( pGroup->pPlayerList );
+	else if ( pGroup->pEnemyGroup )
+		MemFree( pGroup->pEnemyGroup );
+
+	MemFree( pGroup );
+}
+
+static void FreeStrategicMovementGroupListStorage( GROUP *&pHead )
+{
+	while ( pHead )
+	{
+		GROUP *pGroup = pHead;
+		pHead = pHead->next;
+		pGroup->next = NULL;
+		FreeStrategicMovementGroupStorage( pGroup );
+	}
+}
