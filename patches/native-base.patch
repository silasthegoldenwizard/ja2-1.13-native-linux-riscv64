+UINT32 AdjustCounterForceAccuracyForSight(UINT32 uiAccuracy, UINT32 uiRange,
+	INT32 iSightRange, UINT8 ubVisibilityPenalty)
+{
+	// Area fire and stale target locations can legitimately have no soldier and
+	// no line-of-sight range.  Preserve the original 50%/75% visibility
+	// penalties without dividing by zero or casting infinity to an integer.
+	const double dBaseSightRange = iSightRange > 0
+		? static_cast<double>(iSightRange)
+		: static_cast<double>(uiRange > 0 ? uiRange : 1);
+	const double dPenalty = static_cast<double>(ubVisibilityPenalty > 0
+		? ubVisibilityPenalty : 1);
+	const double dAdjusted = static_cast<double>(uiAccuracy) *
+		static_cast<double>(uiRange) / (dBaseSightRange * dPenalty);
+
+	return static_cast<UINT32>(__max(0.0, __min(dAdjusted, 100.0)));
+}
