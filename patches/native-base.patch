+    std::size_t length=0;
+    while (length<textCapacity && text[length]) ++length;
+    if (length==textCapacity) return FALSE;
+    HVOBJECT object=GetFontObject(font);
+    if (!object || !object->pETRLEObject) return FALSE;
+    std::uint64_t pixels=0;
+    std::size_t overflow=length;
