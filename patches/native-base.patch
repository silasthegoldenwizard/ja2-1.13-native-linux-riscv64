+UINT16 ReadLE16(const UINT8* p)
+{
+	return static_cast<UINT16>(static_cast<UINT16>(p[0]) |
+	                          (static_cast<UINT16>(p[1]) << 8));
+}
+
+INT16 ReadLEInt16(const UINT8* p)
+{
+	const UINT16 value = ReadLE16(p);
+	return static_cast<INT16>(value < 0x8000 ? static_cast<INT32>(value)
+	                                      : static_cast<INT32>(value) - 0x10000);
+}
+
+UINT32 ReadLE32(const UINT8* p)
+{
+	return static_cast<UINT32>(p[0]) | (static_cast<UINT32>(p[1]) << 8) |
+	       (static_cast<UINT32>(p[2]) << 16) | (static_cast<UINT32>(p[3]) << 24);
+}
+
+bool ReadExact(HWFILE file, void* destination, UINT32 count)
+{
+	UINT32 read = 0;
+	return count == 0 || (FileRead(file, destination, count, &read) && read == count);
+}
+
+bool ReadAt(HWFILE file, UINT32 offset, void* destination, UINT32 count)
+{
+	// The retained FileSeek API interprets this distance as signed 32-bit.
+	if (offset > static_cast<UINT32>((std::numeric_limits<INT32>::max)())) return false;
+	return FileSeek(file, offset, FILE_SEEK_FROM_START) && ReadExact(file, destination, count);
+}
