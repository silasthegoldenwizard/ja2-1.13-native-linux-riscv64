+bool MayTouchGameTimer()
+{
+    if (clockClosing) { ErrorMsg("JA2 gameplay timer is closing"); return false; }
+    if (clockActive && !driver.IsOwnerThread()) { ErrorMsg("JA2 gameplay timer state belongs to the initialization thread"); return false; }
+    return true;
+}
+void RefreshTimer()
+{
+    if (!gfHispeedClockMode) guiTimeSlice = giFastForwardMode ? 1 : std::max<UINT32>(1, static_cast<UINT32>(UPDATETIMESLICE / 1000));
+    if (clockActive && !driver.Configure(TimerConfiguration())) ErrorMsg("JA2 gameplay timer: invalid configuration or wrong owner thread");
+}
+BOOLEAN UpdateTimeCounter(INT32& counter, INT32& timeLeft)
+{
+    return ja2::game_timer::UpdateCountdown(counter, timeLeft) ? TRUE : FALSE;
+}
+bool ApplyPulse(const ja2::game_timer::Configuration& c)
+{
+    const auto accepted = ja2::game_timer::AcceptedTick(c);
+    bool timerDone = accepted.notify;
+    INT32 iTimeLeft = accepted.timeLeft;
+    const bool overflow = ja2::game_timer::AdvanceClocks(guiBaseJA2Clock, guiBaseJA2NoPauseClock, c.paused);
+    if (!c.paused)
+    {
+        if (overflow)
+        {
+					MapScreenMessage(162, 0, L"guiBaseJA2Clock overflow detected!");
+					for (gCNT = 0; gCNT < TOTAL_SOLDIERS; gCNT++)
+					{
+						if (MercPtrs[gCNT])
+							MercPtrs[gCNT]->ResetSoldierChangeStatTimer();
+					}
+        }
+				for ( gCNT = 0; gCNT < NUMTIMERS; gCNT++ )
+				{
+					timerDone |= UpdateTimeCounter(giTimerCounters[gCNT], iTimeLeft);
+				}
+
+				// Update some specialized countdown timers...
+				timerDone |= UpdateTimeCounter( giTimerAirRaidQuote, iTimeLeft );
+				timerDone |= UpdateTimeCounter( giTimerAirRaidDiveStarted, iTimeLeft );
+				timerDone |= UpdateTimeCounter( giTimerAirRaidUpdate, iTimeLeft );
+				timerDone |= UpdateTimeCounter( giTimerTeamTurnUpdate, iTimeLeft );
+
+				if ( gpCustomizableTimerCallback )
+				{
+					timerDone |= UpdateTimeCounter( giTimerCustomizable, iTimeLeft );
+				}
+
+
+				// If mapscreen...
+				if( guiTacticalInterfaceFlags & INTERFACE_MAPSCREEN )
+				{
+					// IN Mapscreen, loop through player's team.....
+					for ( gCNT = gTacticalStatus.Team[ gbPlayerNum ].bFirstID; gCNT <= gTacticalStatus.Team[ gbPlayerNum ].bLastID; gCNT++ )
+					{
+						gPSOLDIER = MercPtrs[ gCNT ];
+						timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.PortraitFlashCounter, iTimeLeft );
+						timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.PanelAnimateCounter, iTimeLeft );
+					}
+				}
+				else
+				{
+					// Set update flags for soldiers
+					////////////////////////////
+					for ( gCNT = 0; gCNT < guiNumMercSlots; gCNT++ )
+					{
+						gPSOLDIER = MercSlots[ gCNT ];
+
+						if ( gPSOLDIER != NULL )
+						{
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.UpdateCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.DamageCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.ReloadCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.FlashSelCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.BlinkSelCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.PortraitFlashCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.AICounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.FadeCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.NextTileCounter, iTimeLeft );
+							timerDone |= UpdateTimeCounter( gPSOLDIER->timeCounters.PanelAnimateCounter, iTimeLeft );
+#ifdef JA2UB
+							timerDone |= UpdateTimeCounter( gPSOLDIER->GetupFromJA25StartCounter, iTimeLeft );
+#endif
+						}
+					}
+				}
+    }
+    return timerDone;
+}
+std::uint64_t NotifyWaitMicroseconds()
+{
+    const auto minimum = static_cast<UINT32>(MIN_NOTIFY_TIME / 1000);
+    const auto next = driver.NextWaitMicroseconds() / 1000;
+    return std::uint64_t(std::max(minimum, next)) * 1000;
+}
+bool DrainAcceptedPulses()
+{
+    auto backlog = driver.Take();
+    bool notify = false;
+    for (const auto& pulse : backlog)
+        for (std::uint64_t tick = 0; tick < pulse.count; ++tick) notify |= ApplyPulse(pulse.configuration);
+    return notify;
+}
+}
+BOOLEAN InitializeJA2Clock()
+{
+    if (clockClosing) return FALSE;
+    if (clockActive) return driver.IsOwnerThread() ? TRUE : FALSE;
+    if (!SDL_InitSubSystem(SDL_INIT_EVENTS)) { ErrorMsg(SDL_GetError()); return FALSE; }
+    timerEvent = SDL_RegisterEvents(1);
+    if (!timerEvent) { ErrorMsg(SDL_GetError()); SDL_QuitSubSystem(SDL_INIT_EVENTS); return FALSE; }
+    for (INT32 index = 0; index < NUMTIMERS; ++index) giTimerCounters[index] = giTimerIntervals[index];
+    lastNotify = ja2::game_timer::MonotonicMicroseconds(); wakeFailed.store(false); wakePosted.store(false);
+    if (!driver.Start(TimerConfiguration(), WakeMainThread, nullptr)) {
+        ErrorMsg("JA2 gameplay timer worker could not start"); timerEvent = 0; SDL_QuitSubSystem(SDL_INIT_EVENTS); return FALSE;
+    }
+    clockActive = true; RefreshTimer();
+    nextNotifyAt = lastNotify + NotifyWaitMicroseconds();
+    return TRUE;
+}
+UINT32 GetJA2TimerWakeEvent() { return timerEvent; }
+void PumpJA2Clock()
+{
+    if (!clockActive || pumping || clockClosing) return;
+    if (!driver.IsOwnerThread()) { ErrorMsg("JA2 gameplay clock pump must run on its initialization thread"); return; }
+    struct PumpGuard { PumpGuard() { pumping = true; } ~PumpGuard() { pumping = false; } } guard;
+    SDL_FlushEvent(timerEvent); wakePosted.store(false);
+    RefreshTimer();
+    if (wakeFailed.exchange(false)) ErrorMsg("JA2 timer SDL wake was rejected; accepted ticks remain queued");
+    if (!driver.Healthy()) ErrorMsg("JA2 timer worker failed; gameplay timer is no longer advancing");
+    bool notify = DrainAcceptedPulses();
+    const auto now = ja2::game_timer::MonotonicMicroseconds();
+    if (now >= nextNotifyAt) notify = true;
+    if (notify) {
+        lastNotify = now; nextNotifyAt = now + NotifyWaitMicroseconds();
+        if (!notifications.Broadcast(-1)) ErrorMsg("JA2 timer notify dispatch failed; remaining callbacks skipped for this dispatch");
+    }
+}
+void ShutdownJA2Clock()
+{
+    if (!clockActive || clockClosing) return;
+    if (!driver.IsOwnerThread()) { ErrorMsg("JA2 gameplay clock shutdown must run on its initialization thread"); return; }
+    clockClosing = true;
+    struct ClosingScope
+    {
+        bool joined = false;
+        ~ClosingScope()
+        {
+            if (joined)
+            {
+                clockActive = false;
+                SDL_FlushEvent(timerEvent); timerEvent = 0;
+                wakePosted.store(false);
+                SDL_QuitSubSystem(SDL_INIT_EVENTS);
+            }
+            clockClosing = false;
+        }
+    } closing;
+    if (!driver.Stop()) { ErrorMsg("JA2 gameplay clock worker could not join"); return; }
+    closing.joined = true;
+    // Apply every accepted slice, but do not create a new notification dispatch
+    // during shutdown. An already executing notification may finish normally.
+    DrainAcceptedPulses();
+}
+void PauseTime(BOOLEAN paused) { if (!MayTouchGameTimer()) return; PumpJA2Clock(); gfPauseClock = paused; RefreshTimer(); }
