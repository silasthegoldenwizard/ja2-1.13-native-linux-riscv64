 extern int gLastLBEUniqueID;
 
+namespace {
+// Nested map records can append LBE nodes before a later record fails.
+struct MapLBERollback {
+	std::size_t count = LBEArray.size();
+	int lastID = gLastLBEUniqueID;
+	bool committed = false;
+	~MapLBERollback() {
+		if (!committed) {
+			while (LBEArray.size() > count) LBEArray.pop_back();
+			gLastLBEUniqueID = lastID;
+		}
+	}
+};
+struct MapObjectDepth {
+	static thread_local unsigned depth;
+	MapObjectDepth() { ++depth; }
+	~MapObjectDepth() { --depth; }
+};
+thread_local unsigned MapObjectDepth::depth = 0;
+
+bool ValidMapOldObject(const OLD_OBJECTTYPE_101& object) {
+	if (object.usItem >= MAXITEMS || object.ubNumberOfObjects > OLD_MAX_OBJECTS_PER_SLOT_101) return false;
+	if (object.ubNumberOfObjects == 1) {
+		if ((Item[object.usItem].usItemClass & (IC_GUN | IC_LAUNCHER)) &&
+			object.ugYucky.usGunAmmoItem >= MAXITEMS) return false;
+		for (auto item : object.usAttachItem) if (item >= MAXITEMS) return false;
+		if (object.usItem == ACTION_ITEM && object.ugYucky.bActionValue == ACTION_ITEM_BLOW_UP &&
+			object.ugYucky.usBombItem >= MAXITEMS) return false;
+	}
+	return true;
+}
+
+// Save records use the same checked decoder for files and bounded buffers.
+// Keep the input position and destination unchanged if a nested record fails.
+class SaveReadCursor {
+	HWFILE file = 0;
+	CHAR8** output = nullptr;
+	CHAR8* cursor = nullptr;
+	INT32 initialPosition = -1;
+	bool committed = false;
+public:
+	explicit SaveReadCursor(HWFILE source) : file(source), initialPosition(FileGetPos(source)) {}
+	explicit SaveReadCursor(CHAR8** source) : output(source), cursor(source ? *source : nullptr) {}
+	~SaveReadCursor() {
+		if (file && !committed && initialPosition >= 0)
+			FileSeek(file, initialPosition, FILE_SEEK_FROM_START);
+	}
+	bool remaining(std::size_t& bytes) {
+		if (output) {
+			if (!LoadDataFromBuffer(nullptr, cursor, 0, "save cursor")) return false;
+			const auto offset = reinterpret_cast<std::uintptr_t>(cursor) -
+				reinterpret_cast<std::uintptr_t>(gpLoadBufferStart);
+			bytes = static_cast<std::size_t>(giLoadBufferSize) - offset;
+			return true;
+		}
+		if (!file || initialPosition < 0) return false;
+		const auto position = FileGetPos(file);
+		const auto length = FileGetSize(file);
+		if (position < 0 || static_cast<UINT32>(position) > length) return false;
+		bytes = length - static_cast<UINT32>(position);
+		return true;
+	}
+	bool read(void* destination, INT32 bytes) {
+		if (output) return LoadDataFromBuffer(destination, cursor, bytes, "save record");
+		UINT32 read = 0;
+		return file && bytes >= 0 && FileRead(file, destination, bytes, &read) && read == static_cast<UINT32>(bytes);
+	}
+	bool fits(int count, std::size_t minimumBytes) {
+		std::size_t bytes;
+		return count >= 0 && remaining(bytes) && static_cast<std::size_t>(count) <= bytes / minimumBytes;
+	}
+	template<class T> bool load(T& object) {
+		return output ? object.Load(&cursor) : object.Load(file);
+	}
+	void commit() {
+		if (output) *output = cursor;
+		committed = true;
+	}
+};
+
+BOOLEAN LoadSaveLBE(SaveReadCursor& input, LBENODE& destination) {
+	if (guiCurrentSaveGameVersion < NIV_SAVEGAME_DATATYPE_CHANGE) return FALSE;
+	MapLBERollback rollback;
+	LBENODE loaded;
+	int count = 0;
+	if (!input.read(&loaded, SIZEOF_LBENODE_POD) || !input.read(&count, sizeof(count)) ||
+		count < 0 || count > MAX_ITEMS_IN_LBE ||
+		!input.fits(count, SIZEOF_OBJECTTYPE_POD + sizeof(int)) ||
+		loaded.uniqueID < 0 || loaded.uniqueID == INT_MAX) return FALSE;
+	loaded.inv.resize(count);
+	for (auto& object : loaded.inv) if (!input.load(object)) return FALSE;
+	if (loaded.uniqueID >= gLastLBEUniqueID) gLastLBEUniqueID = loaded.uniqueID + 1;
+	memcpy(&destination, &loaded, SIZEOF_LBENODE_POD);
+	destination.inv.swap(loaded.inv);
+	input.commit();
+	rollback.committed = true;
+	return TRUE;
+}
+
+BOOLEAN LoadSaveStack(SaveReadCursor& input, StackedObjectData& destination) {
+	if (guiCurrentSaveGameVersion < NIV_SAVEGAME_DATATYPE_CHANGE) return FALSE;
+	MapLBERollback rollback;
+	StackedObjectData loaded;
+	int count = 0;
+	if (!input.read(&loaded.data, sizeof(ObjectData)) || !input.read(&count, sizeof(count)) ||
+		!input.fits(count, SIZEOF_OBJECTTYPE_POD + sizeof(int))) return FALSE;
+	loaded.attachments.resize(count);
+	for (auto& attachment : loaded.attachments) if (!input.load(attachment)) return FALSE;
+	destination.data = loaded.data;
+	destination.attachments.swap(loaded.attachments);
+	input.commit();
+	rollback.committed = true;
+	return TRUE;
+}
+
+BOOLEAN LoadSaveObject(SaveReadCursor& input, OBJECTTYPE& destination) {
+	MapObjectDepth depth;
+	if (MapObjectDepth::depth > 64) return FALSE;
+	MapLBERollback rollback;
+	OBJECTTYPE loaded;
+	if (guiCurrentSaveGameVersion >= NIV_SAVEGAME_DATATYPE_CHANGE) {
+		int count = 0;
+		if (!input.read(&loaded, SIZEOF_OBJECTTYPE_POD) || loaded.usItem >= MAXITEMS ||
+			!input.read(&count, sizeof(count)) || count < 0 || count >= 512 ||
+			(count == 0 && loaded.usItem != NONE) || count < loaded.ubNumberOfObjects ||
+			!input.fits(count, sizeof(ObjectData) + sizeof(int))) return FALSE;
+		loaded.objectStack.resize(count);
+		int index = 0;
+		for (auto& object : loaded.objectStack) {
+			if (!input.load(object)) return FALSE;
+			if ((Item[loaded.usItem].usItemClass & (IC_GUN | IC_LAUNCHER)) &&
+				object.data.gun.usGunAmmoItem >= MAXITEMS) return FALSE;
+			if (loaded.usItem == ACTION_ITEM && object.data.misc.bActionValue == ACTION_ITEM_BLOW_UP &&
+				object.data.misc.usBombItem >= MAXITEMS) return FALSE;
+			if (loaded.IsActiveLBE(index++)) {
+				LBEArray.push_back(LBENODE());
+				if (!input.load(LBEArray.back())) return FALSE;
+			}
+		}
+	} else {
+		OLD_OBJECTTYPE_101 oldObject;
+		if (!input.read(&oldObject, sizeof(oldObject)) || !ValidMapOldObject(oldObject)) return FALSE;
+		loaded = oldObject;
+	}
+	RemoveProhibitedAttachments(NULL, &loaded, loaded.usItem);
+	// Avoid the assignment operator's legacy action-item conversion for modern records.
+	memcpy(&destination, &loaded, SIZEOF_OBJECTTYPE_POD);
+	destination.objectStack.swap(loaded.objectStack);
+	input.commit();
+	rollback.committed = true;
+	return TRUE;
+}
