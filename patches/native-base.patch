+BOOLEAN ResolveRebelCommandAgentSelection( INT8 selectedAgent, std::size_t rosterSize,
+	std::size_t *pSelectedIndex, BOOLEAN *pIsGenericAgent )
+{
+	if( pSelectedIndex == NULL || pIsGenericAgent == NULL || selectedAgent < 0 )
+		return( FALSE );
+
+	const std::size_t selectedAgentIndex = static_cast<std::size_t>( selectedAgent );
+	if( selectedAgentIndex > rosterSize )
+		return( FALSE );
+
+	*pSelectedIndex = selectedAgentIndex;
+	*pIsGenericAgent = selectedAgentIndex == rosterSize;
+	return( TRUE );
+}
