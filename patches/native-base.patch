+    const auto current = reinterpret_cast<std::uintptr_t>(cursor);
+    const auto offset = current - start;
+    const auto remaining = static_cast<std::uintptr_t>(giLoadBufferSize) - offset;
+    if (static_cast<std::uintptr_t>(trailingSize) > remaining ||
+        static_cast<std::uintptr_t>(count) >
+            (remaining - static_cast<std::uintptr_t>(trailingSize)) / elementSize) {
