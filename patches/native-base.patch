+		header.Indexed.usNumberOfSubImages = ReadLE16(bytes + 28);
+		header.Indexed.ubRedDepth = bytes[30];
+		header.Indexed.ubGreenDepth = bytes[31];
+		header.Indexed.ubBlueDepth = bytes[32];
+	}
+	header.ubDepth = bytes[44];
+	header.uiAppDataSize = ReadLE32(bytes + 45);
+	return true;
