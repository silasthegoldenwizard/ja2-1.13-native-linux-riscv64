+void XMLCALL xmlStart(void* data, const XML_Char* name, const XML_Char** attrs)
+{
+    auto& xml = *static_cast<XmlData*>(data);
+    try
+    {
+        require(xml.path.size() < 6);
+        const std::string parent = xml.path.empty() ? "" : xml.path.back();
+        if (parent.empty()) require(std::strcmp(name, "ImageData") == 0);
+        else if (parent == "ImageData")
+        {
+            require(std::strcmp(name, "SubImage") == 0);
