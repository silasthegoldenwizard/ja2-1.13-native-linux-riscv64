+static VEHICLETYPE *GetValidVehicleRecord( INT32 iVehicleID )
+{
+	if( pVehicleList == NULL || iVehicleID < 0 ||
+		iVehicleID >= ubNumberOfVehicles || !pVehicleList[ iVehicleID ].fValid )
+	{
+		return( NULL );
+	}
+
+	return( &pVehicleList[ iVehicleID ] );
+}
+
+static BOOLEAN GetVehicleMovementGroupForProfile( UINT8 ubProfile, UINT8 *pubMovementGroup )
+{
+	if( pubMovementGroup == NULL )
+	{
+		return( FALSE );
+	}
+
+	*pubMovementGroup = 0;
+	if( pVehicleList == NULL )
+	{
+		return( FALSE );
+	}
+
+	for( UINT16 usVehicle = 0; usVehicle < ubNumberOfVehicles; ++usVehicle )
+	{
+		if( pVehicleList[ usVehicle ].fValid &&
+			pVehicleList[ usVehicle ].ubProfileID == ubProfile &&
+			pVehicleList[ usVehicle ].ubMovementGroup != 0 )
+		{
+			*pubMovementGroup = pVehicleList[ usVehicle ].ubMovementGroup;
+			return( TRUE );
+		}
+	}
+
+	return( FALSE );
+}
+
+static SOLDIERTYPE *GetLiveSquadMember( SOLDIERTYPE *pCandidate )
+{
+	if( pCandidate == NULL )
+	{
+		return( NULL );
+	}
+
+	for( UINT16 usID = 0; usID < TOTAL_SOLDIERS; ++usID )
+	{
+		if( MercPtrs[ usID ] == pCandidate )
