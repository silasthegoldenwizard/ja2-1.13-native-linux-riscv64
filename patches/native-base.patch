-BOOLEAN ReadUncompColMapImage( HIMAGE hImage, HWFILE hFile, UINT8 uiImgID, UINT8 uiColMap, UINT16 fContents )
+BOOLEAN LoadTGAFileToImage(HIMAGE image, UINT16 contents)
+try
 {
-	return( FALSE );
+    if (!image || (contents & ~IMAGE_ALLDATA) ||
+        !std::memchr(image->ImageFile, '\0', sizeof(image->ImageFile))) return FALSE;
+    File file(image->ImageFile);
+    if (!file.handle) return FALSE;
+    UINT8 header[18];
+    if (!read(file.handle, header, sizeof(header)) || header[1] > 1 || header[2] != 2) return FALSE;
+    const UINT16 width = le16(header + 12), height = le16(header + 14);
+    const UINT8 depth = header[16], descriptor = header[17];
+    if (!width || !height || (depth != 16 && depth != 24) || (descriptor & 0xc0)) return FALSE;
+    const UINT32 pixelBytes = depth / 8;
+    const std::uint64_t byteCount = std::uint64_t(width) * height * pixelBytes;
+    const UINT32 mapBytes = header[1] ? UINT32(le16(header + 5)) * ((UINT32(header[7]) + 7) / 8) : 0;
+    const std::uint64_t start = 18u + UINT32(header[0]) + mapBytes;
+    const UINT32 fileSize = FileGetSize(file.handle);
+    if (byteCount > (std::numeric_limits<UINT32>::max)() || start > fileSize || byteCount > fileSize - start)
+        return FALSE;
+    if ((image->fFlags & IMAGE_ALLDATA & ~contents) &&
+        (image->usWidth != width || image->usHeight != height || image->ubBitDepth != depth)) return FALSE;
+    std::unique_ptr<UINT8, Free> pixels;
+    if (contents & IMAGE_BITMAPDATA)
+    {
+        pixels.reset(static_cast<UINT8*>(MemAlloc(static_cast<UINT32>(byteCount))));
+        if (!pixels || !FileSeek(file.handle, static_cast<UINT32>(start), FILE_SEEK_FROM_START)) return FALSE;
+        const UINT32 rowBytes = UINT32(width) * pixelBytes;
+        std::unique_ptr<UINT8, Free> sourceRow(static_cast<UINT8*>(MemAlloc(rowBytes)));
+        if (!sourceRow) return FALSE;
+        for (UINT32 row = 0; row < height; ++row)
+        {
+            if (!read(file.handle, sourceRow.get(), rowBytes)) return FALSE;
+            const UINT32 targetY = (descriptor & 0x20) ? row : UINT32(height) - row - 1;
+            for (UINT32 column = 0; column < width; ++column)
+            {
+                const UINT8* source = sourceRow.get() + column * pixelBytes;
+                const UINT32 targetX = (descriptor & 0x10) ? UINT32(width) - column - 1 : column;
+                UINT8* target = pixels.get() + (std::size_t(targetY) * width + targetX) * pixelBytes;
+                if (depth == 24) { target[0] = source[2]; target[1] = source[1]; target[2] = source[0]; }
+                else
+                {
+                    // Original 16-bit TGA samples remain 5:5:5 values, as in v1.13.
+                    const UINT16 value = le16(source);
+                    std::memcpy(target, &value, sizeof(value));
+                }
+            }
+        }
+    }
+    ReleaseImageData(image, contents);
+    if (contents & IMAGE_BITMAPDATA)
+    {
+        image->p8BPPData = pixels.release();
+        image->uiSizePixData = static_cast<UINT32>(byteCount);
+        image->pETRLEObject = nullptr;
+        image->usNumberOfObjects = 0;
+        image->fFlags |= IMAGE_BITMAPDATA;
+    }
+    image->usWidth = width;
+    image->usHeight = height;
+    image->ubBitDepth = depth;
+    return TRUE;
 }
