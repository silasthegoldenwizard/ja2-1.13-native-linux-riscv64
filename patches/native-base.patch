+bool LoadJPCFileToImage(HIMAGE image, UINT16 contents)
+try
+{
+    require(valid(image, contents));
+    auto bytes = readFile(image->ImageFile);
+    vfs::CBufferFile buffer("");
+    require(buffer.openWrite());
+    require(buffer.write(reinterpret_cast<const vfs::Byte*>(bytes.data()), bytes.size()) == bytes.size());
+    buffer.close();
+    vfs::ObjBlockAllocator<vfs::CLibFile> allocator(128);
+    vfs::CUncompressed7zLibrary library(vfs::tReadableFile::cast(&buffer), "", false, &allocator);
+    require(library.init());
+    std::map<unsigned, vfs::tReadableFile*> files;
+    vfs::tReadableFile* xml = nullptr;
+    for (auto it = library.begin(); !it.end(); it.next())
+    {
+        std::wstring name = it.value()->getName().c_wcs();
+        const auto dot = name.find_last_of(L'.');
+        if (dot == std::wstring::npos) continue;
+        std::wstring ext = name.substr(dot);
+        for (auto& c : ext) if (c >= L'A' && c <= L'Z') c += L'a' - L'A';
+        if (ext == L".png")
+        {
+            require(dot > 0);
+            unsigned index = 0;
+            for (std::size_t i = 0; i < dot; ++i)
+            { require(name[i] >= L'0' && name[i] <= L'9' && index <= (UINT16_MAX - unsigned(name[i] - L'0')) / 10); index = index * 10 + unsigned(name[i] - L'0'); }
+            require(files.emplace(index, vfs::tReadableFile::cast(it.value())).second && files.size() <= UINT16_MAX);
+        }
+        else if (ext == L".xml") { require(xml == nullptr); xml = vfs::tReadableFile::cast(it.value()); }
+    }
+    require(!files.empty());
+    std::vector<Png> frames;
+    std::size_t total = 0;
+    for (const auto& file : files)
+    {
+        auto frame = decode(readMember(file.second, resourceLimit));
+        require(frame.pixels.size() <= (std::numeric_limits<std::size_t>::max)() - total);
+        total += frame.pixels.size();
+        // A multi-frame JPC uses a single common indexed palette.
+        require(files.size() == 1 || frame.channels == 1);
+        if (!frames.empty()) require(std::memcmp(frame.palette.data(), frames[0].palette.data(), sizeof(frame.palette)) == 0);
+        frames.push_back(std::move(frame));
+    }
+    Sections sections;
+    imagesToSections(frames, files.size() > 1, contents, sections);
+    if (xml) parseXml(readMember(xml, xmlLimit), frames.size(), contents, sections);
+    return commit(image, sections, contents);
+}
+catch (...) { return false; }
