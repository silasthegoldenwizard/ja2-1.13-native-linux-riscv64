+bool LoadSubimages(HWFILE file, const STCIHeader& h, const STCISections& sections, STCIData& data)
+{
+	const UINT32 count = h.Indexed.usNumberOfSubImages;
+	data.objects = static_cast<ETRLEObject*>(MemAlloc(count * sizeof(ETRLEObject)));
+	if (!data.objects || !FileSeek(file, sections.subimages, FILE_SEEK_FROM_START)) return false;
+	for (UINT32 i = 0; i < count; ++i)
+	{
+		UINT8 bytes[STCI_SUBIMAGE_SIZE];
+		if (!ReadExact(file, bytes, sizeof(bytes))) return false;
+		ETRLEObject& object = data.objects[i];
+		object.uiDataOffset = ReadLE32(bytes);
+		object.uiDataLength = ReadLE32(bytes + 4);
+		object.sOffsetX = ReadLEInt16(bytes + 8);
+		object.sOffsetY = ReadLEInt16(bytes + 10);
+		object.usHeight = ReadLE16(bytes + 12);
+		object.usWidth = ReadLE16(bytes + 14);
+		if (!ValidateETRLE(data.pixels, h.uiStoredSize, object)) return false;
+	}
+	return true;
+}
