+UINT32 SaturatedMemoryBytes(std::uint64_t units, std::uint64_t unitSize)
+{
+    const auto limit = std::numeric_limits<UINT32>::max();
+    if (!unitSize || units > limit / unitSize) return unitSize ? limit : 0;
+    return static_cast<UINT32>(units * unitSize);
+}
+UINT32 PhysicalMemory(bool available)
+{
+    const long pageSize = ::sysconf(_SC_PAGESIZE);
+    const long pages = ::sysconf(available ? _SC_AVPHYS_PAGES : _SC_PHYS_PAGES);
+    if (pages >= 0 && pageSize > 0)
+        return SaturatedMemoryBytes(static_cast<std::uint64_t>(pages), static_cast<std::uint64_t>(pageSize));
+    struct sysinfo info {};
+    if (::sysinfo(&info) == 0)
+        return SaturatedMemoryBytes(available ? info.freeram : info.totalram, info.mem_unit);
+    MemoryWarning("Memory manager could not query physical memory");
+    return 0;
+}
