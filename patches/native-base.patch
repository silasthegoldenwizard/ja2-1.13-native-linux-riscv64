+bool ValidateDeflate(const STCIHeader& h, const UINT8* pixels)
+{
+	static_assert((std::numeric_limits<uInt>::max)() >= (std::numeric_limits<UINT32>::max)(),
+	              "zlib must support 32-bit input lengths");
+	z_stream stream{};
+	stream.next_in = const_cast<Bytef*>(pixels);
+	stream.avail_in = h.uiStoredSize;
+	if (inflateInit(&stream) != Z_OK) return false;
+	UINT8 output[4096];
+	bool valid = false;
+	for (;;)
+	{
+		stream.next_out = output;
+		stream.avail_out = sizeof(output);
+		const uLong beforeIn = stream.total_in;
+		const uLong beforeOut = stream.total_out;
+		const int result = inflate(&stream, Z_NO_FLUSH);
+		if (stream.total_out > h.uiOriginalSize) break;
+		if (result == Z_STREAM_END)
