+bool ReadHeader(HWFILE file, STCIHeader& header)
+{
+	UINT8 bytes[STCI_HEADER_SIZE];
+	if (!ReadAt(file, 0, bytes, sizeof(bytes)) ||
+	    std::memcmp(bytes, STCI_ID_STRING, STCI_ID_LEN) != 0) return false;
+	std::memset(&header, 0, sizeof(header));
+	std::memcpy(header.cID, bytes, STCI_ID_LEN);
+	header.uiOriginalSize = ReadLE32(bytes + 4);
+	header.uiStoredSize = ReadLE32(bytes + 8);
+	header.uiTransparentValue = ReadLE32(bytes + 12);
+	header.fFlags = ReadLE32(bytes + 16);
+	header.usHeight = ReadLE16(bytes + 20);
+	header.usWidth = ReadLE16(bytes + 22);
+	if (header.fFlags & STCI_RGB)
+	{
+		header.RGB.uiRedMask = ReadLE32(bytes + 24);
+		header.RGB.uiGreenMask = ReadLE32(bytes + 28);
+		header.RGB.uiBlueMask = ReadLE32(bytes + 32);
+		header.RGB.uiAlphaMask = ReadLE32(bytes + 36);
+		header.RGB.ubRedDepth = bytes[40];
+		header.RGB.ubGreenDepth = bytes[41];
+		header.RGB.ubBlueDepth = bytes[42];
+		header.RGB.ubAlphaDepth = bytes[43];
+	}
+	else
