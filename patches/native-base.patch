+bool LoadSubimages(HWFILE file, const STCIHeader& h, const STCISections& sections, STCIData& data, const char*& problem)
+{
+	const UINT32 count = h.Indexed.usNumberOfSubImages;
+	data.objects = static_cast<ETRLEObject*>(MemAlloc(count * sizeof(ETRLEObject)));
+	if (!data.objects) { problem = "ETRLE object allocation failed."; return false; }
+	if (!FileSeek(file, sections.subimages, FILE_SEEK_FROM_START)) { problem = "ETRLE table seek failed."; return false; }
+	for (UINT32 i = 0; i < count; ++i)
+	{
+		UINT8 bytes[STCI_SUBIMAGE_SIZE];
+		if (!ReadExact(file, bytes, sizeof(bytes))) { problem = "ETRLE descriptor read failed."; return false; }
+		ETRLEObject& object = data.objects[i];
+		object.uiDataOffset = ReadLE32(bytes);
+		object.uiDataLength = ReadLE32(bytes + 4);
+		object.sOffsetX = ReadLEInt16(bytes + 8);
+		object.sOffsetY = ReadLEInt16(bytes + 10);
+		object.usHeight = ReadLE16(bytes + 12);
+		object.usWidth = ReadLE16(bytes + 14);
+		if (!ValidateETRLE(data.pixels, h.uiStoredSize, object, problem)) return false;
+	}
+	return true;
+}
+
+bool ValidateDeflate(const STCIHeader& h, const UINT8* pixels)
+{
+	static_assert((std::numeric_limits<uInt>::max)() >= (std::numeric_limits<UINT32>::max)(),
+	              "zlib must support 32-bit input lengths");
+	z_stream stream{};
+	stream.next_in = const_cast<Bytef*>(pixels);
+	stream.avail_in = h.uiStoredSize;
+	if (inflateInit(&stream) != Z_OK) return false;
+	UINT8 output[4096];
+	bool valid = false;
+	for (;;)
+	{
+		stream.next_out = output;
+		stream.avail_out = sizeof(output);
+		const uLong beforeIn = stream.total_in;
+		const uLong beforeOut = stream.total_out;
+		const int result = inflate(&stream, Z_NO_FLUSH);
+		if (stream.total_out > h.uiOriginalSize) break;
+		if (result == Z_STREAM_END)
 		{
-			DbgMessage( TOPIC_HIMAGE, DBG_LEVEL_3, "Palettized image has bad palette size." );
-			return( FALSE );
+			valid = stream.avail_in == 0 && stream.total_out == h.uiOriginalSize;
+			break;
 		}
-		uiFileSectionSize = pHeader->Indexed.uiNumberOfColours * STCI_PALETTE_ELEMENT_SIZE;
-		pSTCIPalette = MemAlloc( uiFileSectionSize );
-		if (pSTCIPalette == NULL)
+		if (result != Z_OK || (stream.total_in == beforeIn && stream.total_out == beforeOut)) break;
+	}
+	inflateEnd(&stream);
+	return valid;
+}
+
+bool ConvertRGB(const STCIHeader& h, STCIData& data)
+{
+	if (!(h.fFlags & STCI_RGB)) return true;
+	if (h.fFlags & STCI_ZLIB_COMPRESSED)
+	{
+		// Keep the original compressed representation for the existing image
+		// decompressor. Never interpret deflate bytes as native RGB16 pixels.
+		return h.ubDepth != 16 ||
+		       (gusRedMask == h.RGB.uiRedMask && gusGreenMask == h.RGB.uiGreenMask && gusBlueMask == h.RGB.uiBlueMask);
+	}
+	const UINT32 count = static_cast<UINT32>(h.usWidth) * h.usHeight;
+	if (h.ubDepth == 32)
+	{
+		for (UINT32 i = 0; i < count; ++i)
+			reinterpret_cast<UINT32*>(data.pixels)[i] = ReadLE32(data.pixels + 4 * i);
+	}
+	if (h.ubDepth != 16) return true;
+	UINT16* pixels = reinterpret_cast<UINT16*>(data.pixels);
+	for (UINT32 i = 0; i < count; ++i) pixels[i] = ReadLE16(data.pixels + 2 * i);
+	if (gusRedMask == h.RGB.uiRedMask && gusGreenMask == h.RGB.uiGreenMask && gusBlueMask == h.RGB.uiBlueMask) return true;
+	// The retained 1.13 conversion helpers specifically accept RGB565 input.
+	if (h.RGB.uiRedMask != 0xF800 || h.RGB.uiGreenMask != 0x07E0 || h.RGB.uiBlueMask != 0x001F) return false;
+	if (gusRedMask == 0x7C00 && gusGreenMask == 0x03E0 && gusBlueMask == 0x001F)
+		ConvertRGBDistribution565To555(pixels, count);
+	else if (gusRedMask == 0xFC00 && gusGreenMask == 0x03E0 && gusBlueMask == 0x001F)
+		ConvertRGBDistribution565To655(pixels, count);
+	else if (gusRedMask == 0xF800 && gusGreenMask == 0x07C0 && gusBlueMask == 0x003F)
+		ConvertRGBDistribution565To556(pixels, count);
+	else ConvertRGBDistribution565ToAny(pixels, count);
+	return true;
+}
