+            require(!xml.seen[xml.index]); xml.seen[xml.index] = true;
+        }
+        else if (parent == "SubImage")
+        {
+            require(std::strcmp(name, "offset") == 0 || std::strcmp(name, "AuxObjectData") == 0);
+            if (std::strcmp(name, "offset") == 0)
+            {
+                auto& offset = xml.offsets[xml.index];
+                if (auto* value = attribute(attrs, "x")) { offset.x = static_cast<INT16>(number(value, INT16_MIN, INT16_MAX)); offset.overrideValue = true; }
+                if (auto* value = attribute(attrs, "y")) { offset.y = static_cast<INT16>(number(value, INT16_MIN, INT16_MAX)); offset.overrideValue = true; }
+            }
+        }
+        else if (parent == "AuxObjectData")
+            require(std::strcmp(name, "flags") == 0 || std::strcmp(name, "ubCurrentFrame") == 0 || std::strcmp(name, "ubNumberOfFrames") == 0 || std::strcmp(name, "ubNumberOfTiles") == 0 || std::strcmp(name, "ubWallOrientation") == 0 || std::strcmp(name, "usTileLocIndex") == 0);
+        else if (parent == "flags")
+        {
+            const char* flags[] = {"AUX_FULL_TILE", "AUX_ANIMATED_TILE", "AUX_DYNAMIC_TILE", "AUX_INTERACTIVE_TILE", "AUX_IGNORES_HEIGHT", "AUX_USES_LAND_Z"};
+            unsigned i = 0; for (; i < 6 && std::strcmp(name, flags[i]) != 0; ++i) {}
+            require(i < 6); xml.aux[xml.index].fFlags |= static_cast<UINT8>(1u << i);
+        }
