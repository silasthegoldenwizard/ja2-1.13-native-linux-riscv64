+    source.fFlags &= static_cast<UINT16>(~contents);
+    target->usWidth = source.usWidth; target->usHeight = source.usHeight; target->ubBitDepth = source.ubBitDepth;
+    return true;
+}
+bool valid(HIMAGE image, UINT16 contents)
+{
+    return image && !(contents & ~IMAGE_ALLDATA) && std::memchr(image->ImageFile, '\0', sizeof(image->ImageFile));
