+			return FALSE;
+
+		// SoldierID constructors cannot protect raw bytes copied from an old save.
+		if (decoded.ubFirerID.i > TOTAL_SOLDIERS || decoded.ubTargetID.i > TOTAL_SOLDIERS || decoded.usAmmoType >= MAXITEMS)
+			return FALSE;
+
+		decoded.uiLastUpdate = 0;
+		decoded.pFirer = decoded.ubFirerID != NOBODY
+			? MercPtrs[decoded.ubFirerID.i]
+			: NULL;
+		decoded.pAniTile = NULL;
+		decoded.pShadowAniTile = NULL;
+		decoded.iBullet = static_cast<INT32>(uiIndex);
+		for (UINT32 uiNode = 0; uiNode < BULLET_TRACER_MAX_LENGTH; ++uiNode)
+			decoded.pNodes[uiNode] = NULL;
+	}
+
+	for (UINT32 uiIndex = 0; uiIndex < uiSavedBulletCount; ++uiIndex)
+		gBullets[uiIndex] = decodedBullets[uiIndex];
+	guiNumBullets = uiSavedBulletCount;
+
+	for (UINT32 uiIndex = 0; uiIndex < guiNumBullets; ++uiIndex)
+		HandleBulletSpecialFlags(gBullets[uiIndex].iBullet);
+
+	return TRUE;
 }
 
