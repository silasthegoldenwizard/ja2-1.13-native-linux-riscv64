+static UINT16 UsableKitPointsFromStatus( UINT16 usStatus, UINT16 usDrainPercent )
+{
+	// Convert remaining item status to the points it can supply after drain reduction.
+	Assert( usDrainPercent > 0 );
+	return (UINT16)( ( (UINT32)usStatus * 100 ) / usDrainPercent );
