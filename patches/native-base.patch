+static SOLDIERTYPE* GetSelectedMapInventorySoldier( void )
+{
+	if ( bSelectedInfoChar < 0 ||
+		bSelectedInfoChar >= giMAXIMUM_NUMBER_OF_PLAYER_SLOTS ||
+		!gCharactersList[ bSelectedInfoChar ].fValid ||
+		gCharactersList[ bSelectedInfoChar ].usSolID >= TOTAL_SOLDIERS )
+	{
+		return NULL;
+	}
+
+	return gCharactersList[ bSelectedInfoChar ].usSolID;
+}
+
+static BOOLEAN GetMapInventoryPoolSlotIndex( MOUSE_REGION* pRegion, INT32* pSlot, size_t* pPoolIndex )
+{
+	if ( pRegion == NULL || pSlot == NULL || pPoolIndex == NULL ||
+		MAP_INVENTORY_POOL_SLOT_COUNT <= 0 || iCurrentInventoryPoolPage < 0 )
+	{
+		return FALSE;
+	}
+
+	const INT32 iSlot = MSYS_GetRegionUserData( pRegion, 0 );
+	if ( iSlot < 0 || iSlot >= MAP_INVENTORY_POOL_SLOT_COUNT )
+	{
+		return FALSE;
+	}
+
+	const UINT64 uiPoolIndex = static_cast<UINT64>( iCurrentInventoryPoolPage ) *
+		static_cast<UINT64>( MAP_INVENTORY_POOL_SLOT_COUNT ) + static_cast<UINT64>( iSlot );
+	if ( uiPoolIndex >= pInventoryPoolList.size() )
+	{
+		return FALSE;
+	}
+
+	*pSlot = iSlot;
+	*pPoolIndex = static_cast<size_t>( uiPoolIndex );
+	return TRUE;
+}
