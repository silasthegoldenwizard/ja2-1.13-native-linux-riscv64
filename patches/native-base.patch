 #define TOOLTIP_TEXT_SIZE 4096
 
+#if !defined(_WIN32)
+namespace {
+// Original self-append formats pass the destination as %s. Format into a
+// temporary so the host CRT never reads and writes overlapping storage.
+template<std::size_t N, typename... Args>
+int TooltipFormat(wchar_t (&out)[N], const wchar_t* format, Args... args) {
+    wchar_t temporary[N];
+    const int n = ja2::native::FormatWide(temporary, N, format, args...);
+    if (n < 0) { out[0]=0; return -1; }
+    std::wmemcpy(out, temporary, static_cast<std::size_t>(n)+1);
+    return n;
+}
+template<std::size_t N>
+wchar_t* TooltipAppend(wchar_t (&out)[N], const wchar_t* text) {
+    if (!text) { out[0]=0; errno=EINVAL; return out; }
+    const auto used=std::wcslen(out), extra=std::wcslen(text);
+    if (used>=N || extra>=N-used) { out[0]=0; errno=ERANGE; return out; }
+    std::wmemmove(out+used,text,extra+1); return out;
+}
+template<std::size_t N>
+wchar_t* TooltipCopy(wchar_t (&out)[N], const wchar_t* text) {
+    if (!text || std::wcslen(text)>=N) { out[0]=0; errno=ERANGE; return out; }
+    std::wmemmove(out,text,std::wcslen(text)+1); return out;
+}
+}
+#define swprintf TooltipFormat
+#define wcscat TooltipAppend
+#define wcscpy TooltipCopy
+#endif
