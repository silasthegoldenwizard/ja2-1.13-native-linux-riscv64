+struct Sections
+{
+    image_type image{};
+    ~Sections() { ReleaseImageData(&image, IMAGE_ALLDATA); }
+};
+template<class T> T* copy(const T* data, std::size_t count)
+{
+    require(count && count <= resourceLimit / sizeof(T));
+    auto* result = static_cast<T*>(MemAlloc(count * sizeof(T)));
+    require(result != nullptr);
+    std::memcpy(result, data, count * sizeof(T));
+    return result;
+}
+void imagesToSections(const std::vector<Png>& frames, bool collection, UINT16 contents, Sections& result)
+{
+    require(!frames.empty() && frames.size() <= UINT16_MAX);
+    auto& image = result.image;
+    image.usWidth = collection ? 640 : frames[0].width;
+    image.usHeight = collection ? 480 : frames[0].height;
+    image.ubBitDepth = frames[0].channels == 1 ? 8 : (frames[0].channels == 3 ? 16 : 32);
+    if ((contents & IMAGE_PALETTE) && image.ubBitDepth == 8)
+    {
+        image.pPalette = copy(frames[0].palette.data(), frames[0].palette.size());
+        image.fFlags |= IMAGE_PALETTE;
+    }
+    if (!(contents & IMAGE_BITMAPDATA)) return;
+    std::vector<ETRLEObject> objects;
+    std::vector<UINT8> pixels;
+    for (const auto& frame : frames)
+    {
+        require(frame.channels == frames[0].channels && (!collection || frame.channels == 1));
+        if (frame.channels == 1) require(std::memcmp(frame.palette.data(), frames[0].palette.data(), sizeof(frame.palette)) == 0);
+        ETRLEObject object{};
+        object.sOffsetX = frame.x; object.sOffsetY = frame.y;
+        object.usWidth = frame.width; object.usHeight = frame.height;
+        object.uiDataOffset = static_cast<UINT32>(pixels.size());
+        std::vector<UINT8> data;
+        if (frame.channels == 1) data = encode(frame);
+        else if (frame.channels == 4) data = frame.pixels; // Original RGBA byte representation, independent of host endian.
+        else
+        {
+            data.resize(static_cast<std::size_t>(frame.width) * frame.height * sizeof(UINT16));
+            for (std::size_t i = 0; i < data.size() / sizeof(UINT16); ++i)
+            {
+                const auto* rgb = frame.pixels.data() + i * 3;
+                const auto color = Get16BPPColor(UINT32(rgb[0]) | (UINT32(rgb[1]) << 8) | (UINT32(rgb[2]) << 16));
+                std::memcpy(data.data() + i * sizeof(color), &color, sizeof(color));
+            }
+        }
+        require(data.size() <= resourceLimit - pixels.size());
+        object.uiDataLength = static_cast<UINT32>(data.size());
+        pixels.insert(pixels.end(), data.begin(), data.end());
+        objects.push_back(object);
+    }
+    image.pImageData = copy(pixels.data(), pixels.size());
+    image.fFlags |= IMAGE_BITMAPDATA;
+    image.pETRLEObject = copy(objects.data(), objects.size());
+    image.usNumberOfObjects = static_cast<UINT16>(objects.size());
+    image.uiSizePixData = static_cast<UINT32>(pixels.size());
+    if (image.ubBitDepth == 8) image.fFlags |= IMAGE_TRLECOMPRESSED;
+}
+struct XmlData
+{
+    std::vector<AuxObjectData> aux;
+    struct Offset { INT16 x = 0, y = 0; bool overrideValue = false; };
+    std::vector<Offset> offsets;
+    std::vector<std::string> path;
+    std::vector<bool> seen;
+    std::string text;
+    std::size_t index = 0;
+    bool failed = false;
+    XML_Parser parser = nullptr;
