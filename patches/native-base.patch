+long number(const std::string& value, long minimum, long maximum)
+{
+    const char* start = value.c_str();
+    while (*start && std::isspace(static_cast<unsigned char>(*start))) ++start;
+    require(*start != '\0');
+    errno = 0; char* end = nullptr;
+    const long parsed = std::strtol(start, &end, 10);
+    require(end != start && errno != ERANGE);
+    while (*end && std::isspace(static_cast<unsigned char>(*end))) ++end;
+    require(*end == '\0' && parsed >= minimum && parsed <= maximum);
+    return parsed;
+}
+const char* attribute(const XML_Char** attrs, const char* name)
+{
+    for (auto a = attrs; a && *a; a += 2) if (std::strcmp(a[0], name) == 0) return a[1];
+    return nullptr;
