 #ifndef __INTELMARKET_H
 #define __INTELMARKET_H
+
+#include <cstdint>
+
+namespace Intelmarket
+{
+	constexpr bool BuildMapIntelFlagMask( std::int16_t region, bool advanced, std::uint32_t& flags ) noexcept
+	{
+		flags = 0;
+		if ( region < 0 || region >= 16 )
+			return false;
+
+		const auto shift = static_cast<unsigned>( region );
+		flags = std::uint32_t{1} << shift;
+		if ( advanced )
+			flags |= std::uint32_t{1} << ( 16u + shift );
+		return true;
+	}
+}
 
