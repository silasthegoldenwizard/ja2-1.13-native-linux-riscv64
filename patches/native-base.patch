+static sgp::NativeVideoRegionState ReadNativeVideoRegionState() noexcept
+{
+	UINT16 width=0,height=0;UINT8 depth=0;
+	GetCurrentVideoSettings(&width,&height,&depth);
+	sgp::NativeVideoRegionState state{gsVIEWPORT_WINDOW_END_Y, gfRenderScroll!=FALSE};
+	// The original copy width is the full framebuffer; strip X globals have
+	// always been 0..SCREEN_WIDTH. Refuse a differing geometry rather than
+	// silently changing that renderer contract.
+	if (depth==16 && gsVIEWPORT_START_X==0 && gsVIEWPORT_END_X==width) {
+		state.scroll={{0,gsVIEWPORT_WINDOW_START_Y,gsVIEWPORT_END_X,gsVIEWPORT_WINDOW_END_Y},
+			static_cast<UINT32>(guiScrollDirection),gsScrollXIncrement,gsScrollYIncrement};
+	}
+	state.zBuffer=gpZBuffer;
+	state.gameScreen=guiCurrentScreen==GAME_SCREEN;
+	return state;
+}
+static bool RenderNativeScrollStrip(const SGPRect& strip)
+{
+	if (strip.iLeft<0 || strip.iTop<0 || strip.iRight>std::numeric_limits<INT16>::max() ||
+		strip.iBottom>std::numeric_limits<INT16>::max()) return false;
+	UINT32 pitch=0;auto* frame=LockVideoSurface(FRAME_BUFFER,&pitch);
+	if (!frame) return false;
+	sgp::NativeSurfaceView view;sgp::BackgroundView z;
+	const bool valid=sgp::LockedNativeSurfaceView(frame,&view) &&
+		sgp::OwnedZBufferView(gpZBuffer,&z) && z.pitch==pitch &&
+		z.width==view.width && z.height==view.height &&
+		gsVIEWPORT_END_Y>=0 && static_cast<UINT32>(gsVIEWPORT_END_Y)<=view.height;
+	UnLockVideoSurface(FRAME_BUFFER);
+	if (!valid) return false;
+	// This calls the genuine renderer, including its original WHOLE-Z clear
+	// through gsVIEWPORT_END_Y on each strip. It is intentionally not replaced
+	// by an exposed-strip-only clear or a successful placeholder.
+	RenderStaticWorldRect(static_cast<INT16>(strip.iLeft),static_cast<INT16>(strip.iTop),
+		static_cast<INT16>(strip.iRight),static_cast<INT16>(strip.iBottom),TRUE);
+	return true;
+}
+static void CommitNativeVideoFrame() noexcept
+{
+	gfRenderScroll=FALSE;
+	gfScrollStart=FALSE;
+	gfIgnoreScrollDueToCenterAdjust=FALSE;
+}
