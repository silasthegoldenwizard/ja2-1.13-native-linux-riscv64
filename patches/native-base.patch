+// Validate a serialized element count against the bytes that remain in the
+// current save buffer. This keeps malformed counts bounded without imposing a
+// gameplay limit on variable-length lists that the save writer can produce.
+BOOLEAN LoadBufferContainsElements(CHAR8* src, UINT32 count, UINT32 elementSize,
+                                   UINT32 trailingSize, const CHAR8* label)
+{
+    CHAR8* cursor = src;
+    if (!LoadDataFromBuffer(nullptr, cursor, 0, label) || elementSize == 0) {
+        gfBufferLoadFailed = TRUE;
+        return FALSE;
+    }
+
