+    // rethrowing, and close invalidates before invoking the throwing provider.
+    // Retrying a stale ID during unwind is safe; never let cleanup throw.
+    struct ScopedGapFile {
+        HWFILE handle;
+        ~ScopedGapFile() noexcept {
+            if (handle) { try { FileClose(handle); } catch (...) {} }
+        }
+        void close() {
+            FileClose(handle);
+            handle = 0;
+        }
+    };
