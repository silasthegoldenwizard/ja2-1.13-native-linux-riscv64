+#if !defined(_WIN32)
+namespace {
+// Preserve _wtoi's representable decimal-prefix values, including leading
+// whitespace/sign, trailing text and zero for no digits. The UI owns a real
+// fixed array; reject missing termination and values outside the original int
+// domain rather than depending on LP64 narrowing or an overflowing conversion.
+template<std::size_t N>
+bool ParseNativeCheatInteger(const wchar_t (&text)[N], int& output)
+{
+    if (!std::wmemchr(text, L'\0', N)) return false;
+    errno = 0;
+    const long value = std::wcstol(text, nullptr, 10);
+    if (errno == ERANGE || value < INT_MIN || value > INT_MAX) return false;
+    output = static_cast<int>(value);
+    return true;
+}
