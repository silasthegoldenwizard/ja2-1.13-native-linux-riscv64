-			return( FALSE );
+			valid = stream.avail_in == 0 && stream.total_out == h.uiOriginalSize;
+			break;
 		}
-		uiFileSectionSize = pHeader->Indexed.uiNumberOfColours * STCI_PALETTE_ELEMENT_SIZE;
-		pSTCIPalette = MemAlloc( uiFileSectionSize );
-		if (pSTCIPalette == NULL)
+		if (result != Z_OK || (stream.total_in == beforeIn && stream.total_out == beforeOut)) break;
+	}
+	inflateEnd(&stream);
+	return valid;
+}
