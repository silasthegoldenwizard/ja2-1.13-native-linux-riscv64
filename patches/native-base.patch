+namespace {
+// Existing source APIs carry no filename capacity. A readable NUL within the
+// original 256-byte path bound is required; continuation slots carry 64 bytes.
+bool NativeGapNameLength(const char* name, std::size_t capacity, std::size_t& length)
+{
+    if (!name) return false;
+    for (length = 0; length < capacity; ++length)
+        if (!name[length]) return length != 0;
+    return false;
+}
+
+bool NativeGapFilename(const char* name, char (&output)[256])
+{
+    std::size_t length;
+    if (!NativeGapNameLength(name, sizeof(output), length)) return false;
+    const char* extension = nullptr;
+    for (std::size_t i = 0; i < length; ++i) {
+        if (name[i] == '/' || name[i] == '\\') extension = nullptr;
+        else if (name[i] == '.') extension = name + i;
+    }
+    if (!extension) return false;
+    const auto prefix = static_cast<std::size_t>(extension - name);
+    if (prefix + sizeof(".gap") > sizeof(output)) return false;
+    std::memcpy(output, name, prefix);
+    std::memcpy(output + prefix, ".gap", sizeof(".gap"));
+    return true;
+}
+
+UINT32 NativeGapRead32(const UINT8* bytes)
+{
+    return UINT32(bytes[0]) | (UINT32(bytes[1]) << 8) |
+           (UINT32(bytes[2]) << 16) | (UINT32(bytes[3]) << 24);
+}
+}
+
+void AudioGapListDone(AudioGapList* list)
+{
+    if (!list) return;
+    auto* gap = list->pHead;
+    while (gap) {
+        auto* next = gap->pNext;
+        MemFree(gap);
+        gap = next;
+    }
+    list->size = 0;
+    list->current_time = 0;
+    list->pHead = list->pCurrent = nullptr;
+    list->audio_gap_active = FALSE;
+}
+
+void AudioGapListInit(CHAR8* filename, AudioGapList* list)
+{
+    if (!list) return;
+    // FACETYPE is zero-initialized before first use. A subsequent utterance can
+    // replace an earlier GAP list before Faces reaches its final cleanup.
+    AudioGapListDone(list);
+    // FileMan size may throw without closing; read closes/invalidates before
+    // rethrowing, and close invalidates before invoking the throwing provider.
+    // Retrying a stale ID during unwind is safe; never let cleanup throw.
+    struct ScopedGapFile {
+        HWFILE handle;
+        ~ScopedGapFile() noexcept {
+            if (handle) { try { FileClose(handle); } catch (...) {} }
+        }
+        void close() {
+            FileClose(handle);
+            handle = 0;
+        }
+    };
+    try {
+        char gapFilename[256];
+        if (!NativeGapFilename(filename, gapFilename) || !FileExists(gapFilename)) return;
+        ScopedGapFile file{FileOpen(gapFilename, FILE_ACCESS_READ, FALSE)};
+        if (!file.handle) return;
+        // .gap is a sequence of little-endian uint32 start/end milliseconds, never
+        // host structs. FileMan UINT32 length bounds the UINT32 record count.
+        const UINT32 bytes = FileGetSize(file.handle);
+        bool valid = bytes % 8 == 0;
+        AUDIO_GAP* tail = nullptr;
+        for (UINT32 index = 0; valid && index < bytes / 8; ++index) {
+            UINT8 record[8];
+            UINT32 read = 0;
+            if (!FileRead(file.handle, record, sizeof(record), &read) || read != sizeof(record)) {
+                valid = false;
+                break;
+            }
+            const auto start = NativeGapRead32(record), end = NativeGapRead32(record + 4);
+            if (start > end) {
+                valid = false;
+                break;
+            }
+            auto* gap = static_cast<AUDIO_GAP*>(MemAlloc(sizeof(AUDIO_GAP)));
+            if (!gap) { valid = false; break; }
+            gap->uiStart = start;
+            gap->uiEnd = end;
+            gap->pNext = nullptr;
+            if (tail) tail->pNext = gap;
+            else list->pHead = gap;
+            tail = gap;
+            ++list->size;
+        }
+        file.close();
+        if (!valid) AudioGapListDone(list);
+        else list->pCurrent = list->pHead;
+    } catch (...) {
+        // Optional sidecar failure must not escape speech startup or retain
+        // partially decoded nodes. The scoped FileMan ID is already released.
+        AudioGapListDone(list);
+    }
+}
