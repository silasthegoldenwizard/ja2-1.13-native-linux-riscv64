+bool ConvertRGB(const STCIHeader& h, STCIData& data)
+{
+	if (!(h.fFlags & STCI_RGB)) return true;
+	if (h.fFlags & STCI_ZLIB_COMPRESSED)
+	{
+		// Keep the original compressed representation for the existing image
+		// decompressor. Never interpret deflate bytes as native RGB16 pixels.
+		return h.ubDepth != 16 ||
+		       (gusRedMask == h.RGB.uiRedMask && gusGreenMask == h.RGB.uiGreenMask && gusBlueMask == h.RGB.uiBlueMask);
+	}
+	const UINT32 count = static_cast<UINT32>(h.usWidth) * h.usHeight;
+	if (h.ubDepth == 32)
+	{
+		for (UINT32 i = 0; i < count; ++i)
+			reinterpret_cast<UINT32*>(data.pixels)[i] = ReadLE32(data.pixels + 4 * i);
+	}
+	if (h.ubDepth != 16) return true;
+	UINT16* pixels = reinterpret_cast<UINT16*>(data.pixels);
+	for (UINT32 i = 0; i < count; ++i) pixels[i] = ReadLE16(data.pixels + 2 * i);
+	if (gusRedMask == h.RGB.uiRedMask && gusGreenMask == h.RGB.uiGreenMask && gusBlueMask == h.RGB.uiBlueMask) return true;
+	// The retained 1.13 conversion helpers specifically accept RGB565 input.
+	if (h.RGB.uiRedMask != 0xF800 || h.RGB.uiGreenMask != 0x07E0 || h.RGB.uiBlueMask != 0x001F) return false;
+	if (gusRedMask == 0x7C00 && gusGreenMask == 0x03E0 && gusBlueMask == 0x001F)
+		ConvertRGBDistribution565To555(pixels, count);
+	else if (gusRedMask == 0xFC00 && gusGreenMask == 0x03E0 && gusBlueMask == 0x001F)
+		ConvertRGBDistribution565To655(pixels, count);
+	else if (gusRedMask == 0xF800 && gusGreenMask == 0x07C0 && gusBlueMask == 0x003F)
+		ConvertRGBDistribution565To556(pixels, count);
+	else ConvertRGBDistribution565ToAny(pixels, count);
+	return true;
+}
