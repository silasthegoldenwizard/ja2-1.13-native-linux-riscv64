+void WakeMainThread(void*)
+{
+    if (wakePosted.exchange(true)) return;
+    SDL_Event event{}; event.type = timerEvent;
+    if (!SDL_PushEvent(&event)) { wakePosted.store(false); wakeFailed.store(true); }
